{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appwrite Account Databases API",
    "version": "1.6.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Appwrite-Project",
      "value": "{{X-Appwrite-Project}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Databases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appwrite - List Databases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.appwrite.io/v1/databases"
          },
          "docs": "Returns a list of all databases in the Appwrite project"
        }
      ]
    }
  ],
  "bundled": true
}