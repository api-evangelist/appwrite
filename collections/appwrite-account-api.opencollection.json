{
  "opencollection": "1.0.0",
  "info": {
    "name": "Appwrite Account API",
    "version": "1.6.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Appwrite-Project",
      "value": "{{X-Appwrite-Project}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Appwrite - Get Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cloud.appwrite.io/v1/account"
          },
          "docs": "Returns the currently authenticated user account information"
        }
      ]
    }
  ],
  "bundled": true
}